<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1"/>
        <PackageReference Include="Myra" Version="1.6.8"/>
        <PackageReference Include="Tomlyn" Version="2.11.1"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="assets/config.toml" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="assets/langs/**/*.toml" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="assets/fonts/*.ttf" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="assets/mods/**/*"
              Link="mods/%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>