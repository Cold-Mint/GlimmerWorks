<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <Version>0.0.3</Version>
        <AssemblyVersion>0.0.0.3</AssemblyVersion>
        <FileVersion>0.0.0.3</FileVersion>
        <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Arch" Version="2.1.0"/>
        <PackageReference Include="Karambolo.PO" Version="1.13.0"/>
        <PackageReference Include="MemoryPack" Version="1.22.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <AdditionalFiles Include="BannedSymbols.txt"/>
        <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="11.0.0"/>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1"/>
        <PackageReference Include="Myra" Version="1.6.8"/>
        <PackageReference Include="Tomlyn" Version="2.11.1"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="assets/config.toml" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="assets/langs/**/*.toml" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="assets/fonts/*.ttf" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="assets/mods/**/*" Link="mods/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>