<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>GlimmerWorks.Game</RootNamespace>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <ModsDirectory>assets/mods</ModsDirectory>
        <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))</RepositoryRoot>
    </PropertyGroup>

    <Target Name="PrepareModRepositories" BeforeTargets="PrepareForBuild">
        <Exec Command="git submodule update --init --remote &quot;Game/$(ModsDirectory)/data_packs/glimmerworks&quot; &quot;Game/$(ModsDirectory)/assets_pack/glimmerworks_res&quot;"
              WorkingDirectory="$(RepositoryRoot)"/>
        <ItemGroup>
            <ModFile Include="$(ModsDirectory)/**/*"
                     Exclude="$(ModsDirectory)/**/.git/**/*;$(ModsDirectory)/**/.git"/>
            <ModFile>
                <Link>mods/%(RecursiveDir)%(Filename)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ModFile>
            <None Include="@(ModFile)"/>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\Engine\Engine.csproj"/>
        <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="11.0.0"/>
        <PackageReference Include="Myra.PlatformAgnostic" Version="1.6.8"/>
        <PackageReference Include="Karambolo.PO" Version="1.13.0"/>
        <PackageReference Include="SDL3-CS" Version="3.4.20"/>
        <PackageReference Include="SDL3-CS.Windows" Version="3.4.20"/>
        <PackageReference Include="SDL3-CS.Windows.Image" Version="3.4.8.1"/>
        <PackageReference Include="SDL3-CS.Linux" Version="3.4.20"/>
        <PackageReference Include="SDL3-CS.Linux.Image" Version="3.4.8.1"/>
        <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="assets/config.toml" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="assets/langs/*.po" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="assets/fonts/*.ttf" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
